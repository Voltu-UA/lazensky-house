<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <%
    // page variable comes from server: '', 'about', 'gallery', 'contact', etc.
    const meta = {
      home: {
        title: 'Лазеньський Дім — ЖК у Яремче',
        desc: 'Сучасний житловий комплекс у серці Карпат. Квартири з панорамними вікнами, екологічна зона, вигідне розташування.',
        canonical: 'https://lazensky.if.ua/',
        ogImage: 'https://lazensky.if.ua/images/preview.jpg'
      },
      about: {
        title: 'Про будинок — Лазеньський Дім',
        desc: 'Деталі про проєкт, концепцію та комфорт житлового комплексу в Яремче.',
        canonical: 'https://lazensky.if.ua/about',
        ogImage: 'https://lazensky.if.ua/images/preview-about.jpg'
      },
      construction: {
        title: 'Стадії будівництва — Лазеньський Дім',
        desc: 'Оновлення та короткі відео з будівельного майданчика ЖК у Яремче.',
        canonical: 'https://lazensky.if.ua/construction',
        ogImage: 'https://lazensky.if.ua/images/preview-construction.jpg'
      },
      gallery: {
        title: 'Галерея — Лазеньський Дім',
        desc: 'Фотографії та відео будівництва, інтер\'єрів та навколишньої природи ЖК у Яремче.',
        canonical: 'https://lazensky.if.ua/gallery',
        ogImage: 'https://lazensky.if.ua/images/preview-gallery.jpg'
      },
      plans: {
        title: 'Планування квартир — Лазеньський Дім',
        desc: 'Планування, площі та варіанти квартир у ЖК Лазеньський Дім.',
        canonical: 'https://lazensky.if.ua/plans',
        ogImage: 'https://lazensky.if.ua/images/preview-plans.jpg'
      },
      benefits: {
        title: 'Переваги — Лазеньський Дім',
        desc: 'Переваги розташування, інфраструктури та характеристик комплексу.',
        canonical: 'https://lazensky.if.ua/benefits',
        ogImage: 'https://lazensky.if.ua/images/preview-benefits.jpg'
      },
      contact: {
        title: 'Контакти — Лазеньський Дім',
        desc: 'Контактна інформація, офіс продажу та форма для запису на перегляд.',
        canonical: 'https://lazensky.if.ua/contact',
        ogImage: 'https://lazensky.if.ua/images/preview-contact.jpg'
      }
    };
    const routeKey = (page && page !== 'home') ? page : 'home';
    const currentMeta = meta[routeKey] || meta.home;
  %>

  <title><%= currentMeta.title %></title>
  <meta name="description" content="<%= currentMeta.desc %>" />
  <link rel="canonical" href="<%= currentMeta.canonical %>" />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph (kept dynamic for url & description, image optional per route) -->
  <meta property="og:title" content="<%= currentMeta.title %>" />
  <meta property="og:description" content="<%= currentMeta.desc %>" />
  <meta property="og:image" content="<%= currentMeta.ogImage %>" />
  <meta property="og:url" content="<%= currentMeta.canonical %>" />
  <meta property="og:type" content="website" />

  <meta name="keywords" content="Яремче, Карпати, житло, новобудова, квартири, нерухомість" />
  <meta name="author" content="Лазеньський Дім" />

  <link rel="icon" href="https://lazensky.if.ua/images/logo-icon.png" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/styles.css?v=<%= assetVersion %>" />
</head>

<body itemscope itemtype="https://schema.org/Residence">
  <header>
    <div class="overlay text-center text-white d-flex flex-column justify-content-center align-items-center">
      <h1 class="overlay-title mb-3">Лазеньський Дім</h1>
      <p class="fs-4 mb-4">Ідеальне поєднання комфорту, простору та мальовничих краєвидів в самому серці Карпат</p>

      <!-- Logo link -->
      <a href="/about" aria-label="Перейти до секції Про будинок">
        <div id="logo" class="position-relative d-inline-block pulse">
          <img src="/images/logo3.png" alt="Лазеньський Дім Логотип" class="img-fluid" />
        </div>
      </a>
    </div>
  </header>

  <!-- Nav -->
  <nav aria-label="Головна навігація">
    <ul>
      <li><a href="/about">Про будинок</a></li>
      <li><a href="/construction">Стадії будівництва</a></li>
      <li><a href="/gallery">Галерея</a></li>
      <li><a href="/plans">Планування Квартир</a></li>
      <li><a href="/benefits">Переваги</a></li>
      <li><a href="/contact">Контакти</a></li>
    </ul>
  </nav>

  <main>
    <section id="about" class="py-5">
    <div class="container">
      <h2 class="mb-4">Про будинок</h2>
        <div class="video-container mb-4">
          <div class="ratio ratio-16x9">
            <video autoplay muted loop playsinline preload="metadata">
              <source src="/videos/vid-1.mp4" type="video/mp4">
              Ваш браузер не підтримує відео.
            </video>
          </div>
        </div>
      <p itemprop="description" class="lead">
        У самому серці Яремче, серед величних Карпат, ми створили житловий комплекс, що поєднує природну гармонію з сучасним комфортом. Це місце, де кожен день починається з панорами гір, свіжого повітря та відчуття спокою.
      </p>

      <div class="row mt-4">
        <div class="col-md-6 mb-4">
          <h3 class="h5">🌲 Природа поруч</h3>
          <p>
            Водоспади, лісові стежки, гірські річки та гуцульські традиції — усе це за кілька хвилин від вашого дому. Зимою — лижі та засніжені вершини, влітку — походи, тиша лісу та відпочинок на природі.
          </p>
        </div>
        <div class="col-md-6 mb-4">
          <h3 class="h5">🏡 Комфорт і якість</h3>
          <p>
            Сучасний багатоквартирний будинок з панорамними вікнами, екологічними матеріалами та енергоефективними рішеннями. Просторі квартири спроєктовані для затишку, світла та зручності.
          </p>
        </div>
      </div>

      <div>
        <h3 class="h5">🌿 Гармонія простору</h3>
        <p>
          Ми продумали кожну деталь — від фасаду до внутрішнього планування. Це ідеальне місце для тих, хто цінує естетику, спокій і якість життя. Тут ви знайдете дім, у якому хочеться залишитися.
        </p>
      </div>

      <p class="mt-4 fs-5 fw-semibold text-dark">
        Обирайте дім, де кожен день — як відпустка.
      </p>
    </div>
    </section>

    <section id="construction" class="py-5">
      <div class="container">
        <h2 class="mb-4 text-center">Стадії будівництва</h2>

        <div class="construction-controls mb-4">
          <label for="constructionMonthPrev" class="form-label text-white fw-semibold mb-2">Оберіть місяць</label>
          <div id="constructionMonthCarousel" class="month-carousel">
            <button id="constructionMonthPrev" type="button" class="month-carousel-btn" aria-label="Попередній місяць">←</button>
            <div id="constructionMonthCurrent" class="month-carousel-current" aria-live="polite">Оберіть місяць</div>
            <button id="constructionMonthNext" type="button" class="month-carousel-btn" aria-label="Наступний місяць">→</button>
          </div>
        </div>

        <div id="constructionMonthContent" class="construction-month-card" aria-live="polite">
          <div class="ratio ratio-16x9 mb-3">
            <iframe
              id="constructionVideo"
              src=""
              title="Будівництво"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <p id="constructionDescription" class="mb-2"></p>
          <button id="constructionReadMoreBtn" type="button" class="construction-read-more" aria-expanded="false">
            Читати більше
          </button>
          <div id="constructionDetails" class="construction-details">
            <ul id="constructionHighlights"></ul>
            <div id="constructionPhotos" class="construction-photos"></div>
            <a
              id="constructionYoutubeLink"
              class="construction-link"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
            >
              Відкрити відео в YouTube
            </a>
          </div>
        </div>

        <p class="mt-4 text-white text-center">
          Ми регулярно публікуємо короткі відео з будівельного майданчика, щоб ви могли бачити прогрес у реальному часі.
        </p>
      </div>
    </section>

